{
 "job_name": "gpt-5-openrouter_modal",
 "agent_timeout_multiplier": 2.0,
 "verifier_timeout_multiplier": 2.0,
 "n_concurrent_trials": 4,
 "environment": {
  "type": "modal",
  "override_cpus": 8,
  "override_memory_mb": 16384,
  "kwargs": {
   "app_name": "cheatbench-swe"
  }
 },
 "datasets": [
  {
   "path": "tasks/software_engineering/harbor/tasks"
  }
 ],
 "agents": [
  {
   "name": "codex",
   "model_name": "openrouter/openai/gpt-5",
   "kwargs": {
    "version": "0.154.0",
    "reasoning_effort": "high",
    "reasoning_summary": "detailed"
   },
   "env": {
    "OPENAI_API_KEY": "${OPENROUTER_API_KEY}",
    "OPENAI_BASE_URL": "https://openrouter.ai/api/v1"
   }
  }
 ]
}
