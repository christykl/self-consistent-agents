{
 "job_name": "gemini-4-argon-vertex_modal",
 "agent_timeout_multiplier": 2.0,
 "verifier_timeout_multiplier": 2.0,
 "n_concurrent_trials": 4,
 "environment": {
  "type": "modal",
  "override_cpus": 8,
  "override_memory_mb": 16384,
  "kwargs": {
   "app_name": "cheatbench-swe"
  }
 },
 "datasets": [
  {
   "path": "tasks/software_engineering/harbor/tasks"
  }
 ],
 "agents": [
  {
   "import_path": "tasks.software_engineering.harbor.vertex_gemini:VertexGeminiAcp",
   "model_name": "google/gemini-4-argon@default",
   "kwargs": {
    "registry_entry_path": "tasks/software_engineering/harbor/acp/gemini-4-argon-vertex.json"
   },
   "env": {
    "GEMINI_API_KEY": "relay-holds-the-credential",
    "GOOGLE_GEMINI_BASE_URL": "http://127.0.0.1:8765"
   }
  }
 ]
}
